# Nitrogen output is regenerated by `npm run nitrogen` from src/specs/*.nitro.ts.
# Committing it is also a valid choice (it lets consumers build without running
# the codegen) -- if you switch to that, drop this entry and commit the tree.
/nitrogen/generated/

node_modules/

# The XCFramework the podspec builds on first `pod install`. Anchored with a
# leading slash: a bare "ios/" also matches example/ios/, which would quietly
# drop the example app's whole Xcode project from the repository.
/ios/

# Native build output.
/android/.cxx/
/android/build/

*.log
vendor/
