{
  "name": "react-native-librats",
  "version": "0.1.0",
  "description": "React Native bindings for librats - P2P networking, via Nitro Modules",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "cpp",
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/src",
    "nitrogen/generated",
    "nitro.json",
    "scripts",
    "vendor",
    "LibratsRN.podspec",
    "README.md"
  ],
  "scripts": {
    "prepare": "nitrogen",
    "nitrogen": "nitrogen",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf nitrogen/generated",
    "vendor": "node scripts/vendor-core.mjs",
    "prepack": "node scripts/vendor-core.mjs && nitrogen"
  },
  "keywords": [
    "react-native",
    "librats",
    "p2p",
    "nitro",
    "networking"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "nitrogen": "^0.37.0",
    "react-native": "^0.87.0",
    "react-native-nitro-modules": "^0.37.0",
    "typescript": "^5.5.0"
  }
}
